{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "클로드 마인드맵",
  "version": "0.1.0",
  "identifier": "com.avabag01.claude-mindmap",
  "build": {
    "frontendDist": "web-dist",
    "beforeBuildCommand": "node scripts/web-sync.js",
    "beforeDevCommand": "node scripts/web-sync.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "클로드 마인드맵",
        "width": 1500,
        "height": 950,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": { "signingIdentity": "Claude Mindmap Local Signing", "hardenedRuntime": false }
  }
}
